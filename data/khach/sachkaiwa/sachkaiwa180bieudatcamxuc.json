[{"id":"001","title":"1. 泣きそう","titleF":"1. [泣](な)きそう","translation":"Sắp khóc / Muốn khóc / Suýt khóc","explanation":"Ý nghĩa: Dùng khi xúc động mạnh (vì vui hoặc buồn) đến mức sắp bật khóc.\n\nLưu ý:\n• Gợi ý 1 - Không giỏi biểu lộ cảm xúc: nhìn chung người Nhật không giỏi thể hiện cảm xúc. Vì họ không bộc lộ ra khi xúc động nên khán giả Nhật ít vỗ tay, ít bày tỏ sự thán phục; một số nghệ sĩ nước ngoài vì thế thấy khó biểu diễn trước khán giả Nhật.","audioPath":"./data/filenghesachkaiwa/180bieudatcamxuc/cum1.m4a","conversations":[{"context":"Hội thoại 1: Sau khi xem phim","dialogues":[{"speaker":"A","ja":"〈[映画](えいが)を[見](み)た[後](あと)〉[最後](さいご)は_[泣](な)きそう_になったよ。[久々](ひさびさ)にいい[映画](えいが)だった。","vi":"(Sau khi xem phim) Đoạn cuối mình suýt khóc đấy. Lâu lắm rồi mới có bộ phim hay thế.","startTime":5.08,"endTime":9.35},{"speaker":"B","ja":"ほんと、[感動](かんどう)した。","vi":"Ừ thật, mình cũng xúc động lắm.","startTime":9.35,"endTime":11.02}]},{"context":"Hội thoại 2","dialogues":[{"speaker":"","ja":"せっかくこんなに[準備](じゅんび)したのに[中止](ちゅうし)だなんて、もう_[泣](な)きそう_。","vi":"Công chuẩn bị bao nhiêu thế này mà lại bị hủy, mình sắp khóc đến nơi rồi.","startTime":14.25,"endTime":18.34}]}]},{"id":"002","title":"2. やった！","translation":"Yeah! / Tuyệt quá! / Được rồi!","explanation":"Ý nghĩa: Dùng để bày tỏ niềm vui khi gặp tin tốt, kết quả như mong đợi hoặc khoản thu nhập bất ngờ.","audioPath":"./data/filenghesachkaiwa/180bieudatcamxuc/cum2.m4a","conversations":[{"context":"Hội thoại 1: Ở công ty","dialogues":[{"speaker":"A","ja":"〈[会社](かいしゃ)で〉[今日](きょう)は[早](はや)く[帰](かえ)ってもいいよ。","vi":"(Ở công ty) Hôm nay cậu được về sớm đấy.","startTime":3.89,"endTime":5.96},{"speaker":"B","ja":"_やった_！","vi":"Yeah!","startTime":5.96,"endTime":6.86}]},{"context":"Hội thoại 2","dialogues":[{"speaker":"A","ja":"〈[合格](ごうかく)を[知](し)って〉_やった_、[合格](ごうかく)だ！","vi":"(Biết mình đã đỗ) Yeah, đỗ rồi!","startTime":10.08,"endTime":12.54},{"speaker":"B","ja":"_やった_ね。…ねえ、[泣](な)かないでよ。こっちまで[泣](な)きそうになる。","vi":"Tuyệt quá. … Này, đừng khóc mà. Mình cũng sắp khóc theo rồi.","startTime":12.54,"endTime":17.91}]}]},{"id":"003","title":"3. めちゃめちゃ","translation":"Cực kỳ / Vô cùng / Rất","explanation":"Ý nghĩa: Dùng như trạng từ trong văn nói, diễn tả mức độ vượt quá mong đợi.","audioPath":"./data/filenghesachkaiwa/180bieudatcamxuc/cum3.m4a","conversations":[{"context":"Hội thoại 1","dialogues":[{"speaker":"A","ja":"はるかさんの[料理](りょうり)、_めちゃめちゃ_おいしかったです。ごちそうさまでした。","vi":"Món ăn của Haruka ngon cực kỳ luôn. Cảm ơn vì bữa ăn.","startTime":5.14,"endTime":9.67},{"speaker":"B","ja":"いいえ、どういたしまして。","vi":"Không có gì ạ.","startTime":9.67,"endTime":11.75}]},{"context":"Hội thoại 2","dialogues":[{"speaker":"A","ja":"〈[友達](ともだち)の[子供](こども)の[頃](ころ)の[写真](しゃしん)を[見](み)て〉わあ、_めちゃめちゃ_[可愛](かわい)いじゃん。","vi":"(Xem ảnh hồi nhỏ của bạn) Oa, dễ thương cực kỳ luôn.","startTime":15.03,"endTime":17.91},{"speaker":"B","ja":"いいよ、お[世辞](せじ)は。","vi":"Thôi đi, đừng nịnh.","startTime":17.91,"endTime":19.59}]}]},{"id":"004","title":"4. よし！","locked":true},{"id":"005","title":"5. じーんとする／じーんとくる","locked":true},{"id":"006","title":"6. ウルウルする","locked":true},{"id":"007","title":"7. 感激！","titleF":"7. [感激](かんげき)！","locked":true},{"id":"008","title":"8. ワクワクする","locked":true},{"id":"009","title":"9. 言葉にできない","titleF":"9. [言葉](ことば)にできない","locked":true},{"id":"010","title":"10. 泣ける","titleF":"10. [泣](な)ける","locked":true},{"id":"011","title":"11. そのままズバリ","locked":true},{"id":"012","title":"12. 胸を打つ","titleF":"12. [胸](むね)を[打](う)つ","locked":true},{"id":"013","title":"13. かっこいい","locked":true},{"id":"014","title":"14. すごい","locked":true},{"id":"015","title":"15. びっくり","locked":true},{"id":"016","title":"16. ほんと","locked":true},{"id":"017","title":"17. そんな","locked":true},{"id":"018","title":"18. まじ","locked":true},{"id":"019","title":"19. 〜なんて","locked":true},{"id":"020","title":"20. うそ","locked":true},{"id":"021","title":"21. まさか","locked":true},{"id":"022","title":"22. 信じられない","titleF":"22. [信](しん)じられない","locked":true},{"id":"023","title":"23. いいんですか","locked":true},{