[{"id":"001","title":"1. ペラペラ","translation":"Trôi chảy / Bép xép, nói huyên thuyên","hinh":"tuvung-hinh/kaiwa-tt-001.webp","explanation":"Ý nghĩa:\n1. Dáng vẻ nói ngoại ngữ trôi chảy, không vấp váp, không bị ngắt quãng giữa chừng, nói liền một mạch như nước chảy.\n2. Dáng vẻ nói năng vô trách nhiệm, không suy nghĩ kỹ.\n\nCách dùng:\n• Nghĩa 1 hay dùng khi đánh giá năng lực của ai đó (nói ngoại ngữ giỏi).\n• Nghĩa 2 hay dùng khi nhắc nhở hoặc chê trách ai đó ăn nói, hành động thiếu cẩn trọng.\n\nDạng hay dùng:\n• ペラペラ V「話す」「しゃべる」\n• ペラペラと V\n• 「〜語はペラペラだ」","explanationF":"Ý nghĩa:\n1. Dáng vẻ nói ngoại ngữ trôi chảy, không vấp váp, không bị ngắt quãng giữa chừng, nói liền một mạch như nước chảy.\n2. Dáng vẻ nói năng vô trách nhiệm, không suy nghĩ kỹ.\n\nCách dùng:\n• Nghĩa 1 hay dùng khi đánh giá năng lực của ai đó (nói ngoại ngữ giỏi).\n• Nghĩa 2 hay dùng khi nhắc nhở hoặc chê trách ai đó ăn nói, hành động thiếu cẩn trọng.\n\nDạng hay dùng:\n• ペラペラ V「[話](はな)す」「しゃべる」\n• ペラペラと V\n• 「〜[語](ご)はペラペラだ」","audioPath":"./data/filenghesachkaiwa/tuongthanhtuonghinh/cum1.m4a","conversations":[{"context":"Hội thoại 1","dialogues":[{"speaker":"A","ja":"すごいなあ、[彼女](かのじょ)。[英語](えいご)もドイツ[語](ご)も_ペラペラ_だね。","vi":"Cô ấy giỏi thật đấy. Cả tiếng Anh lẫn tiếng Đức đều nói trôi chảy.","startTime":3.86,"endTime":8.93},{"speaker":"B","ja":"フランス[語](ご)も_ペラペラ_だよ。","vi":"Tiếng Pháp cô ấy cũng nói trôi chảy luôn.","startTime":8.93,"endTime":11.11}]},{"context":"Ví dụ 2","dialogues":[{"speaker":"","ja":"[私](わたし)のプライバシーを[人](ひと)に_ペラペラ_しゃべらないで。","vi":"Đừng có đem chuyện riêng tư của tôi đi bép xép với người khác.","startTime":14.5,"endTime":18.4}]}]},{"id":"002","title":"2. ぶつぶつ","translation":"Lầm bầm / Càu nhàu","hinh":"tuvung-hinh/kaiwa-tt-002.webp","explanation":"Ý nghĩa:\n1. Dáng vẻ nói bằng giọng nhỏ, khó nghe rõ, nói lí nhí trong miệng.\n2. Dáng vẻ nói sau lưng những lời than phiền, bất mãn.\n\nCách dùng:\n• Nghĩa 1 thường dùng cho những lời tự nói một mình.\n\nDạng hay dùng:\n• ぶつぶつ V「言う」\n• ぶつぶつと V","explanationF":"Ý nghĩa:\n1. Dáng vẻ nói bằng giọng nhỏ, khó nghe rõ, nói lí nhí trong miệng.\n2. Dáng vẻ nói sau lưng những lời than phiền, bất mãn.\n\nCách dùng:\n• Nghĩa 1 thường dùng cho những lời tự nói một mình.\n\nDạng hay dùng:\n• ぶつぶつ V「[言](い)う」\n• ぶつぶつと V","audioPath":"./data/filenghesachkaiwa/tuongthanhtuonghinh/cum2.m4a","conversations":[{"context":"Hội thoại 1","dialogues":[{"speaker":"A","ja":"あの[人](ひと)、ずっと[独](ひと)り[言](ごと)を_ぶつぶつ_[言](い)ってるよ。","vi":"Người đó cứ lầm bầm nói một mình mãi ấy.","startTime":3.78,"endTime":8.46},{"speaker":"B","ja":"ちょっと[変](へん)な[人](ひと)かも。","vi":"Có khi ông ấy hơi kỳ quặc đấy.","startTime":8.46,"endTime":10.06}]},{"context":"Ví dụ 2","dialogues":[{"speaker":"","ja":"そんなに_ぶつぶつ_[言](い)うなら、やめたら？","vi":"Nếu cứ càu nhàu mãi như vậy thì sao không thôi luôn đi?","startTime":13.39,"endTime":16.61}]}]},{"id":"003","title":"3. シクシク","translation":"Khóc thút thít / Sụt sùi","hinh":"tuvung-hinh/kaiwa-tt-003.webp","explanation":"Ý nghĩa: Dáng vẻ khóc yếu ớt, buồn bã, không phát ra nhiều tiếng.\n\nCách dùng:\n• Đây là kiểu khóc yếu ớt, nhưng không tạo ấn tượng tiêu cực.\n\nDạng hay dùng:\n• シクシク V「泣く」\n\nLưu ý:\n• Cùng từ này còn được giải thích ở bài 120 (シクシク).","explanationF":"Ý nghĩa: Dáng vẻ khóc yếu ớt, buồn bã, không phát ra nhiều tiếng.\n\nCách dùng:\n• Đây là kiểu khóc yếu ớt, nhưng không tạo ấn tượng tiêu cực.\n\nDạng hay dùng:\n• シクシク V「[泣](な)く」\n\nLưu ý:\n• Cùng từ này còn được giải thích ở bài 120 (シクシク).","audioPath":"./data/filenghesachkaiwa/tuongthanhtuonghinh/cum3.m4a","conversations":[{"context":"Hội thoại 1","dialogues":[{"speaker":"A","ja":"よう[子](こ)は[悲](かな)しかっただろうね。","vi":"Yoko chắc đã buồn lắm nhỉ.","startTime":4.06,"endTime":6.79},{"speaker":"B","ja":"うん…。あれからずっと、[部屋](へや)で_シクシク_[泣](な)いてたみたい。","vi":"Ừ… Từ hôm đó đến giờ hình như bạn ấy cứ ngồi khóc thút thít trong phòng.","startTime":6.79,"endTime":12.39}]},{"context":"Hội thoại 2","dialogues":[{"speaker":"A","ja":"あの[子](こ)、[迷子](まいご)じゃない？","vi":"Cô bé kia có phải bị lạc không nhỉ?","startTime":15.7,"endTime":18.76},{"speaker":"B","ja":"なんか、_シクシク_[泣](な)いてるね。きっと、そうだよ。","vi":"Hình như bé đang khóc thút thít kìa. Chắc là vậy rồi.","startTime":18.76,"endTime":22.92}]}]},{"id":"004","title":"4. わんわん","locked":true},{"id":"005","title":"5. ちらっと／ちらりと","locked":true},{"id":"006","title":"6. ちらちら","locked":true},{"id":"007","title":"7. じっと","locked":true},{"id":"008","title":"8. じろじろ","locked":true},{"id":"009","title":"9. ごくごく","locked":true},{"id":"010","title":"10. がぶがぶ","locked":true},{"id":"011","title":"11. ゲラゲラ","locked":true},{"id":"012","title":"12. クスクス","locked":true},{"id":"013","title":"13. にこにこ","locked":true},{"id":"014","title":"14. にっこり","locked":true},{"id":"015","title":"15. ニヤニヤ","locked":true},{"id":"016","title":"16. くるくる","locked":true},{"id":"017","title":"17. コロコロ","locked":true},{"id":"018","title":"18. ぐるっと","locked":true},{"id":"019","title":"19. ぐっすり","locked":true},{"id":"020","title":"20. スヤスヤ","locked":true},{"id":"021","title":"21. ザーザー","locked":true},{"id":"022","title":"22. しとしと","locked":true},{"id":"023","title":"23. ポツポツ","locked":true},{"id":"024","title":"24. パラパラ","locked":true},{"id":"025","title":"25. さっと","locked":true},{"id":"026","title":"26. ざっと","locked":true},{"id":"027","title":"27. すっと","locked":true},{"id":"028","title":"28. そっと","locked":true},{"id":"029","title":"29. てきぱき","locked":true},{"id":"030","title":"30. わざわざ","locked":true},{"id":"031","title":"31. きちんと","locked":true},{"id":"032","title":"32. ちゃんと","locked":true},{"id":"033","title":"33. しっかり","locked":true},{"id":"034","title":"34. じっくり","locked":true},{"id":"035","title":"35. きっぱり","locked":true},{"id":"036","title":"36. どんどん","locked":true},{"id":"037","title":"37. グングン","locked":true},{"id":"038","title":"38. すらすら","locked":true},{"id":"039","title":"39. サクサク","locked":true},{"id":"040","title":"40. がらりと／がらっと","locked":true},{"id":"041","title":"41. ずらりと／ずらっと","locked":true},{"id":"042","title":"42. どっと","locked":true},{