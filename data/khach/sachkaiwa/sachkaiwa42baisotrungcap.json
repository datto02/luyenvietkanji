[{"id":"01","title":"PHẦN 1 - BÀI 1","translation":"Độ khó: 1/5","explanation":"Trước hết hãy làm quen với những âm tiếng Nhật từ những câu chào và các đoạn hội thoại ngắn. Bạn hoàn toàn có thể sử dụng những ngữ pháp căn bản để giao tiếp trọn vẹn với người Nhật.","audioPath":"./data/filenghesachkaiwa/sdn1/sdn1p1.m4a","conversations":[{"context":"Tình huống 1","dialogues":[{"speaker":"A","ja":"そう？","vi":"Vậy sao?","startTime":3.6,"endTime":6.6},{"speaker":"B","ja":"そう。","vi":"Đúng vậy.","startTime":6.6,"endTime":7.8}]},{"context":"Tình huống 2","dialogues":[{"speaker":"A","ja":"え～、どれ？　これ？","vi":"Ơ, cái nào? Cái này á?","startTime":7.8,"endTime":11.8},{"speaker":"B","ja":"うん。それ。","vi":"Ừ, cái đó.","startTime":11.8,"endTime":13.8}]},{"context":"Tình huống 3","dialogues":[{"speaker":"A","ja":"おいしい？","vi":"Ngon không?","startTime":13.8,"endTime":16.4},{"speaker":"B","ja":"うん。おいしいよ。","vi":"Có. Ngon lắm.","startTime":16.4,"endTime":18.8}]},{"context":"Tình huống 4","dialogues":[{"speaker":"A","ja":"はい？","vi":"Có không?","startTime":18.8,"endTime":21},{"speaker":"B","ja":"はい。","vi":"Có.","startTime":21,"endTime":22.4}]},{"context":"Tình huống 5","dialogues":[{"speaker":"A","ja":"きれい？","vi":"Đẹp không?","startTime":22.4,"endTime":25},{"speaker":"B","ja":"きれい。","vi":"Đẹp.","startTime":25,"endTime":26.3}]},{"context":"Tình huống 6","dialogues":[{"speaker":"A","ja":"[本当](ほんとう)？","vi":"Thật không?","startTime":26.3,"endTime":29.2},{"speaker":"B","ja":"[本当](ほんとう)。","vi":"Thật.","startTime":29.2,"endTime":30.5}]},{"context":"Tình huống 7","dialogues":[{"speaker":"A","ja":"[田中](たなか)さん？","vi":"Tanaka-san á?","startTime":30.5,"endTime":33.8},{"speaker":"B","ja":"[田中](たなか)さん。","vi":"Ừ, Tanaka-san.","startTime":33.8,"endTime":35.2}]},{"context":"Tình huống 8","dialogues":[{"speaker":"A","ja":"いい？","vi":"Được không?","startTime":35.2,"endTime":38.2},{"speaker":"B","ja":"いいよ。","vi":"Được.","startTime":38.2,"endTime":39.5}]},{"context":"Tình huống 9","dialogues":[{"speaker":"A","ja":"ここ？","vi":"Ở đây à?","startTime":39.5,"endTime":42.3},{"speaker":"B","ja":"うん。そこ。","vi":"Ừ, ở đấy.","startTime":42.3,"endTime":44.3}]},{"context":"Tình huống 10","dialogues":[{"speaker":"A","ja":"わかった？","vi":"Cậu đã hiểu chưa?","startTime":44.3,"endTime":47.7},{"speaker":"B","ja":"はい。わかりました。","vi":"Dạ. Em đã hiểu rồi ạ.","startTime":47.7,"endTime":49.8}]}]},{"id":"02","title":"PHẦN 1 - BÀI 2","translation":"","explanation":"Tình huống 4: お先に失礼します\\nCâu chào nói với người ở lại khi bạn rời khỏi nơi làm việc sau khi kết thúc ngày làm việc.","explanationF":"Tình huống 4: お[先](さき)に[失礼](しつれい)します\\nCâu chào nói với người ở lại khi bạn rời khỏi nơi làm việc sau khi kết thúc ngày làm việc.","audioPath":"./data/filenghesachkaiwa/sdn1/sdn1p2.m4a","conversations":[{"context":"Tình huống 1","dialogues":[{"speaker":"A","ja":"こんにちは。","vi":"Chào cậu.","startTime":1.68,"endTime":4.14},{"speaker":"B","ja":"こんにちは。","vi":"Chào cậu.","startTime":4.14,"endTime":5.46}]},{"context":"Tình huống 2","dialogues":[{"speaker":"A","ja":"[先生](せんせい)、おはようございます。","vi":"Em chào thầy/cô.","startTime":5.46,"endTime":9.27},{"speaker":"B","ja":"おはよう。","vi":"Chào em.","startTime":9.27,"endTime":10.64}]},{"context":"Tình huống 3","dialogues":[{"speaker":"A","ja":"えみさん、じゃーね。","vi":"Emi, hẹn gặp lại cậu sau.","startTime":10.64,"endTime":14.3},{"speaker":"B","ja":"うん。また[明日](あした)。","vi":"Ừ. Mai gặp lại nhé!","startTime":14.3,"endTime":16.33}]},{"context":"Tình huống 4","dialogues":[{"speaker":"A","ja":"お[先](さき)に[失礼](しつれい)します。","vi":"Tôi xin phép về trước.","startTime":16.33,"endTime":19.85},{"speaker":"B","ja":"おつかれさまー。","vi":"Cảm ơn anh đã vất vả làm việc.","startTime":19.85,"endTime":21.86}]},{"context":"Tình huống 5","dialogues":[{"speaker":"A","ja":"あ～あ。","vi":"Ôi trời!","startTime":21.86,"endTime":25.23},{"speaker":"B","ja":"すみません。","vi":"Tôi xin lỗi.","startTime":25.23,"endTime":27.11}]},{"context":"Tình huống 6","dialogues":[{"speaker":"A","ja":"いってきます。","vi":"Anh đi đây!","startTime":27.11,"endTime":29.83},{"speaker":"B","ja":"いってらっしゃい。","vi":"Anh đi nhé!","startTime":29.83,"endTime":31.25}]},{"context":"Tình huống 7","dialogues":[{"speaker":"A","ja":"ただいまー。","vi":"Anh đã về!","startTime":31.25,"endTime":34.81},{"speaker":"B","ja":"おかえりー。","vi":"Mừng anh về nhà!","startTime":34.81,"endTime":36.62}]},{"context":"Tình huống 8","dialogues":[{"speaker":"A","ja":"どうもありがとうございます。","vi":"Cảm ơn chị.","startTime":36.62,"endTime":39.87},{"speaker":"B","ja":"いいえ、どういたしまして。","vi":"Không, không có gì.","startTime":39.87,"endTime":42.43}]},{"context":"Tình huống 9","dialogues":[{"speaker":"A","ja":"いい[天気](てんき)ですね。","vi":"Trời đẹp nhỉ!","startTime":42.43,"endTime":45.64},{"speaker":"B","ja":"ええ、そうですね。","vi":"Vâng, đúng thế thật.","startTime":45.64,"endTime":47.67}]},{"context":"Tình huống 10","dialogues":[{"speaker":"A","ja":"お[元気](げんき)ですか？","vi":"Chị có khỏe không?","startTime":47.67,"endTime":50.92},{"speaker":"B","ja":"はい、[元気](げんき)です。","vi":"Có, tôi khỏe.","startTime":50.92,"endTime":52.81}]}]},{"id":"03","title":"PHẦN 1 - BÀI 3","translation":"","explanation":"","audioPath":"./data/filenghesachkaiwa/sdn1/sdn1p3.m4a","conversations":[{"context":"Tình huống 1","dialogues":[{"speaker":"A","ja":"[何時](なんじ)ですか？","vi":"Mấy giờ rồi?","startTime":1.7,"endTime":4.8},{"speaker":"B","ja":"9[時](じ)です。","vi":"9 giờ.","startTime":4.8,"endTime":6.1}]},{"context":"Tình huống 2","dialogues":[{"speaker":"A","ja":"[今](いま)、[何時](なんじ)ですか？","vi":"Bây giờ là mấy giờ?","startTime":6.1,"endTime":9.2},{"speaker":"B","ja":"4[時](じ)。","vi":"4 giờ.","startTime":9.2,"endTime":10.5}]},{"context":"Tình huống 3","dialogues":[{"speaker":"A","ja":"[何時](なんじ)にねましたか？","vi":"Anh đi ngủ lúc mấy giờ?","startTime":10.5,"endTime":13.8},{"speaker":"B","ja":"11[時半](じはん)ぐらいです。","vi":"Khoảng 11 giờ rưỡi.","startTime":13.8,"endTime":15.8}]},{"context":"Tình huống 4","dialogues":[{"speaker":"A","ja":"テストは[何時](なんじ)からですか？","vi":"Mấy giờ bắt đầu kiểm tra?","startTime":15.8,"endTime":19.2},{"speaker":"B","ja":"10[時](じ)からですよ。","vi":"10 giờ.","startTime":19.2,"endTime":21.2}]},{"context":"Tình huống 5","dialogues":[{"speaker":"A","ja":"[今日](きょう)は[何日](なんにち)ですか？","vi":"Hôm nay là ngày mấy?","startTime":21.2,"endTime":24.5},{"speaker":"B","ja":"4[月](がつ)[1日](ついたち)です。","vi":"Ngày 1 tháng 4.","startTime":24.5,"endTime":26.3}]},{"context":"Tình huống 6","dialogues":[{"speaker":"A","ja":"[今日](きょう)は[何曜日](なんようび)？","vi":"Hôm nay là thứ mấy?","startTime":26.3,"endTime":29.7},{"speaker":"B","ja":"[水曜日](すいようび)だよ。","vi":"Là thứ 4.","startTime":29.7,"endTime":31.5}]},{"context":"Tình huống 7","dialogues":[{"speaker":"A","ja":"[誕生日](たんじょうび)はいつですか？","vi":"Bao giờ sinh nhật anh?","startTime":31.5,"endTime":34.9},{"speaker":"B","ja":"8[月](がつ)[20日](はつか)です。","vi":"20 tháng 8.","startTime":34.9,"endTime":36.8}]},{"context":"Tình huống 8","dialogues":[{"speaker":"A","ja":"[銀行](ぎんこう)は[何時](なんじ)から[何時](なんじ)までですか？","vi":"Ngân hàng làm việc từ mấy giờ đến mấy giờ?","startTime":36.8,"endTime":41.5},{"speaker":"B","ja":"9[時](じ)から3[時](じ)までです。","vi":"Từ 9 giờ đến 3 giờ.","startTime":41.5,"endTime":43.6}]},{"context":"Tình huống 9","dialogues":[{"speaker":"A","ja":"[今年](ことし)は[何年](なんねん)？","vi":"Năm nay là năm bao nhiêu?","startTime":43.6,"endTime":46.9},{"speaker":"B","ja":"2006[年](ねん)。[平成](へいせい)18[年](ねん)だよ。","vi":"Năm 2006. Năm Bình Thành thứ 18.","startTime":46.9,"endTime":50.2}]},{"context":"Tình huống 10","dialogues":[{"speaker":"A","ja":"[日本](にほん)に[来](き)て、どのぐらいですか？","vi":"Anh tới Nhật bao lâu rồi?","startTime":50.2,"endTime":54.7},{"speaker":"B","ja":"1[年](ねん)3[ヶ月](かげつ)です。","vi":"1 năm 3 tháng.","startTime":54.7,"endTime":56.8}]}]},{"id":"04","title":"PHẦN 1 - BÀI 4","locked":true},{"id":"05","title":"PHẦN 1 - BÀI 5","locked":true},{"id":"06","title":"PHẦN 1 - BÀI 6","locked":true},{"id":"07","title":"PHẦN 1 - BÀI 7","locked":true},{"id":"08","title":"PHẦN 1 - BÀI 8","locked":true},{"id":"09","title":"PHẦN 1 - BÀI 9","locked":true},{"id":"10","title":"PHẦN 1 - BÀI 10","locked":true},{"id":"11","title":"PHẦN 2 - BÀI 1","locked":